<?xml version="1.0" encoding="utf-8"?>

<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical">
    <androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:background="@color/gray"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/left_bottom_guideline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_begin="@dimen/space_xl" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/right_bottom_guideline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_end="@dimen/space_xl" />

        <ImageView
            android:id="@+id/artwork"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:contentDescription="oblojka"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/track_placeholder" />


        <TextView
            android:id="@+id/playlist_name"
            android:layout_width="0dp"
            app:layout_constrainedWidth="true"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xxl"
            android:textSize="@dimen/text_size_xl"
            android:fontFamily="@font/ys_display_medium"
            android:textFontWeight="700"
            android:textColor="@color/dark_blue"
            android:text="Dont't play Bae"
            app:layout_constraintTop_toBottomOf="@id/artwork"
            android:textAlignment="textStart"
            app:layout_constraintStart_toStartOf="@id/left_bottom_guideline"
            app:layout_constraintEnd_toEndOf="@id/right_bottom_guideline"/>

        <TextView
            android:id="@+id/playlist_year"
            android:layout_width="0dp"
            app:layout_constrainedWidth="true"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:textSize="18sp"
            android:fontFamily="@font/ys_display_regular"
            android:textColor="@color/dark_blue"
            android:text="2022"
            app:layout_constraintTop_toBottomOf="@id/playlist_name"
            android:textAlignment="textStart"
            app:layout_constraintStart_toStartOf="@id/left_bottom_guideline"
            app:layout_constraintEnd_toEndOf="@id/right_bottom_guideline"/>

        <TextView
            android:id="@+id/playlist_chtoto_za4emto"
            android:layout_width="0dp"
            app:layout_constrainedWidth="true"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:textSize="18sp"
            android:fontFamily="@font/ys_display_regular"
            android:textColor="@color/dark_blue"
            android:text="Dont't play Bae"
            app:layout_constraintTop_toBottomOf="@id/playlist_year"
            android:textAlignment="textStart"
            app:layout_constraintStart_toStartOf="@id/left_bottom_guideline"
            app:layout_constraintEnd_toEndOf="@id/right_bottom_guideline"/>

        <ImageButton
            android:id="@+id/share_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="@dimen/space_xl"
            app:layout_constraintHorizontal_chainStyle="spread_inside"
            app:layout_constraintStart_toStartOf="@id/left_bottom_guideline"
            android:src="@drawable/share_action_icon"
            android:backgroundTint="@android:color/transparent"
            app:layout_constraintTop_toBottomOf="@id/playlist_chtoto_za4emto" />

        <ImageButton
            android:id="@+id/more_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="@dimen/space_xl"
            app:layout_constraintHorizontal_chainStyle="spread_inside"
            app:layout_constraintTop_toTopOf="@id/share_icon"
            app:layout_constraintStart_toEndOf="@id/share_icon"
            android:src="@drawable/more_action_icon"
            android:backgroundTint="@android:color/transparent"
            app:layout_constraintTop_toBottomOf="@id/playlist_chtoto_za4emto" />
    </androidx.constraintlayout.widget.ConstraintLayout>


    <LinearLayout
        android:id="@+id/tracks_bottom_sheet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bottom_sheet_bg"
        android:orientation="vertical"
        android:layout_gravity="center"
        app:behavior_hideable="false"
        app:behavior_peekHeight="240dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_margin="6dp"
            android:background="@drawable/bottom_sheet_handler" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/tracks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/more_bottom_sheet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bottom_sheet_bg"
        android:orientation="vertical"
        android:layout_gravity="center"
        app:behavior_hideable="true"
        app:behavior_peekHeight="385dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_margin="6dp"
            android:background="@drawable/bottom_sheet_handler" />
        <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            xmlns:tools="http://schemas.android.com/tools"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/space_l"
            android:paddingVertical="@dimen/space_s">
            <ImageView
                android:id="@+id/playlist_artwork"
                android:layout_width="45dp"
                android:layout_height="45dp"/>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:paddingHorizontal="@dimen/space_s"
                android:paddingTop="@dimen/space_xs"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/playlist_title"
                    style="@style/TrackNameStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:ellipsize="end"
                    tools:text="@string/dark_theme"/>
                <TextView
                    android:id="@+id/playlist_tracks"
                    style="@style/TrackDescriptionStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    tools:text="@string/dark_theme"/>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/playlist_share"
            style="@style/MenuItemStyle"
            android:layout_marginVertical="@dimen/space_xl2"
            android:layout_marginHorizontal="@dimen/space_xl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/share"/>
        <TextView
            android:id="@+id/playlist_edit"
            style="@style/MenuItemStyle"
            android:layout_marginVertical="@dimen/space_xl2"
            android:layout_marginHorizontal="@dimen/space_xl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/edit_info"/>
        <TextView
            android:id="@+id/playlist_delete"
            style="@style/MenuItemStyle"
            android:layout_marginVertical="@dimen/space_xl2"
            android:layout_marginHorizontal="@dimen/space_xl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/delete_playlist"/>
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
